# Required
DEEPGRAM_API_KEY=%api_key%

# Optional (defaults shown)
# Backend API server port
PORT=8081
# Server host
HOST=0.0.0.0

# Flux TTS voice (format: flux-{voice}-{language})
# DEEPGRAM_TTS_MODEL=flux-alexis-en

# Session auth (set in production to enable stable JWT signing)
# SESSION_SECRET=%session_secret%
